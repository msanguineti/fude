{
  "name": "fude",
  "version": "5.0.0-rc.1",
  "description": "Node.js library for terminal text style formatting",
  "keywords": [
    "terminal",
    "colors",
    "formatting",
    "cli",
    "console"
  ],
  "author": "Mirco Sanguineti",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json && npm run optimize",
    "optimize": "terser dist/index.js --mangle toplevel -c toplevel,passes=2,ecma=2022 -o dist/index.js",
    "check": "tsc --noEmit",
    "test": "node --test",
    "test:coverage": "npm run clean && tsc -p tsconfig.json && node --test --experimental-test-coverage --test-coverage-include=dist/index.js",
    "test:package": "npm run verify && node scripts/check-package.cjs",
    "verify": "npm run build && npm test",
    "prepack": "npm run verify"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "colorize-template": "^1.0.0",
    "terser": "^5.51.2",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msanguineti/fude.git"
  },
  "bugs": {
    "url": "https://github.com/msanguineti/fude/issues"
  },
  "homepage": "https://github.com/msanguineti/fude#readme",
  "dependencies": {}
}
